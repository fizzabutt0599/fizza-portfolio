# Public site URL (used for SEO metadata, sitemap and Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Contact form delivery (server-side only, never prefixed with NEXT_PUBLIC_) ----
# Choose one provider: "formspree" | "resend" | "none"
# "none" logs submissions on the server (handy for local development).
CONTACT_PROVIDER=none

# Formspree: create a form at https://formspree.io and paste its ID (e.g. xayzabcd)
FORMSPREE_FORM_ID=

# Resend: create an API key at https://resend.com
RESEND_API_KEY=
# Sender must be on a domain verified in Resend (onboarding@resend.dev works for testing)
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>
# Inbox that receives messages
CONTACT_TO_EMAIL=bfiza278@gmail.com
